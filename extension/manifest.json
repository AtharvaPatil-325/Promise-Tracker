{
  "manifest_version": 3,
  "name": "PromiseTracker — Customer Follow-up Assistant",
  "version": "1.0.0",
  "description": "Capture promises and follow-ups made to customers directly from web pages and emails.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*.promisetracker.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromiseTracker"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
